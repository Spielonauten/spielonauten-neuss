---
import Layout from '../layouts/Layout.astro';
import VeranstaltungsEintrag from '../components/VeranstaltungsEintrag.astro';
import { veranstaltungen } from '../data/veranstaltungen.js';
import seitentexte from '../content/seitentexte.json';
const texte = seitentexte.veranstaltungen;

// Reihenfolge wie auf der bisherigen Veranstaltungsseite.
const reihenfolge = [
  'offener-brettspieleabend',
  'rheingespielt',
  'ikea',
  'vorhang-auf',
  'xxl-spieletag',
  'thalia',
];
const eintraege = reihenfolge.map((id) => veranstaltungen.find((v) => v.id === id)).filter(Boolean);
---
<Layout title="Veranstaltungen" description="Unsere offenen Spieleabende und Brettspielveranstaltungen in Neuss – Termine, Orte und Teilnahmeinformationen.">
  <section class="band band--blue title-hero">
    <div class="shell narrow">
      <h1>{texte.titel}</h1>
      <p>{texte.einleitung}</p>
      <div class="kalender-abonnement">
        <a class="button" href="webcal://spielonauten-neuss.de/kalender.ics" aria-label="Spielonauten-Veranstaltungskalender abonnieren">📅 Veranstaltungskalender abonnieren</a>
        <p class="kalender-abonnement-hilfe">Für Google Kalender: <a href="https://spielonauten-neuss.de/kalender.ics">Kalenderadresse kopieren</a> und in Google Kalender unter „Weitere Kalender → Per URL“ hinzufügen. Bitte abonnieren statt einmalig importieren.</p>
      </div>
    </div>
  </section>
  {eintraege.map((eintrag, position) => (
    <VeranstaltungsEintrag veranstaltung={eintrag} position={position} />
  ))}
</Layout>

<script>
  import { naechsterTerminText, zukunftstermine, statusText } from '../data/terminanzeige.js';
  for (const section of document.querySelectorAll('[data-event-feature]')) {
    const termine = JSON.parse(section.getAttribute('data-event-terms') || '[]');
    const next = section.querySelector('[data-event-next]');
    if (next) next.textContent = naechsterTerminText(termine);
    const list = section.querySelector('[data-event-upcoming-list]');
    if (list) {
      list.replaceChildren();
      const upcoming = zukunftstermine(termine);
      if (!upcoming.length) {
        const li = document.createElement('li');
        li.textContent = 'Weitere Termine werden noch bekannt gegeben.';
        list.append(li);
      } else {
        upcoming.forEach((termin) => {
          const li = document.createElement('li');
          li.className = `event-term-item event-term-item--${termin.status}`;
          li.textContent = statusText(termin);
          list.append(li);
        });
      }
    }
  }
</script>

<style>
  .kalender-abonnement { margin: 1.6rem auto 0; display: flex; align-items: center; flex-direction: column; gap: .55rem; }
  .kalender-abonnement .button { display: inline-block; max-width: 100%; white-space: normal; }
  .kalender-abonnement-hilfe { font-size: .85rem; line-height: 1.45; max-width: 58ch; margin: 0; }
  .kalender-abonnement-hilfe a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
</style>
