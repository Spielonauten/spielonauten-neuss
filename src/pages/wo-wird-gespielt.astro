---
import Layout from '../layouts/Layout.astro';
import spielorte from '../content/spielorte.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = '/spielonauten-neuss/';

// Pages CMS speichert volle öffentliche Pfade. GitHub Pages benötigt den
// Repository-Basispfad genau einmal (auch bei neu hochgeladenen Fotos).
const bild = (pfad) => {
  const wert = typeof pfad === 'string' ? pfad.trim() : '';
  if (!wert) return '';
  if (wert.startsWith(prefix)) return `${base}/${wert.slice(prefix.length)}`;
  if (wert.startsWith('/bilder/')) return `${base}${wert}`;
  if (wert.startsWith('bilder/')) return `${base}/${wert}`;
  return `${base}/bilder/spielorte/${wert.replace(/^\/+/, '')}`;
};

const kardinal = spielorte.kardinal;
const theater = spielorte.theater;
const haltestellen = Array.isArray(kardinal.haltestellen) ? kardinal.haltestellen : [];
const wegschritte = Array.isArray(kardinal.wegschritte) ? kardinal.wegschritte : [];
const theaterFoyerSteps = Array.isArray(theater.foyerSchritte) ? theater.foyerSchritte : [];
---
<Layout title="Wo wird gespielt?" description="Spielorte und Anfahrt der Spielonauten Neuss: Wegbeschreibung zum Kardinal-Bea-Haus und Informationen zum Rheinischen Landestheater.">
  <section class="band band--blue title-hero venue-title">
    <div class="shell narrow">
      <h1>Wo wird gespielt?</h1>
      <p>{spielorte.einleitung}</p>
      <nav class="venue-jump-links" aria-label="Direkt zum Spielort springen">
        <a class="button" href="#kardinal-bea-haus">{kardinal.name} <span aria-hidden="true">↓</span></a>
        <a class="button" href="#rheinisches-landestheater">{theater.name} <span aria-hidden="true">↓</span></a>
      </nav>
    </div>
  </section>

  <section id="kardinal-bea-haus" class="band band--white" aria-labelledby="kardinal-title">
    <div class="shell venue-split">
      <div class="venue-copy">
        <p class="venue-kicker venue-kicker--place">Spielort 01</p>
        <h2 id="kardinal-title">{kardinal.name}</h2>
        <p>{kardinal.beschreibung}</p>
        <address><strong>Zugang für unsere Gäste:</strong><br />{kardinal.eingang}<br />{kardinal.plzOrt}</address>
        <p class="venue-small-note">Die Gebäudeadresse wird auch unter {kardinal.gebaeudeadresse} geführt. {kardinal.zugangshinweis}</p>
      </div>
      <img class="venue-lead-image" src={bild(kardinal.titelbild)} alt={kardinal.titelbildAlt} width="1600" height="1064" decoding="async" />
    </div>
  </section>

  <!-- Beide Bereiche sind unabhängig voneinander aufklappbar. -->
  <section class="band band--blue venue-options-band" aria-labelledby="kardinal-details-title">
    <div class="shell">
      <h2 id="kardinal-details-title" class="section-heading">Anfahrt und Wegbeschreibung</h2>
      <p class="venue-area-intro">Wähle die Informationen aus, die du für deinen Besuch im {kardinal.name} brauchst.</p>
      <div class="venue-choices">
        <details class="venue-collapse venue-collapse--card">
          <summary class="venue-collapse-summary">
            <span class="venue-collapse-summary-text">
              <span class="venue-area-number">Anreise und Karte</span>
              <strong>So kommst du zum {kardinal.name}</strong>
              <span>Kartenlinks, öffentliche Verkehrsmittel und Parkmöglichkeiten</span>
            </span>
            <span class="venue-collapse-icon" aria-hidden="true"></span>
          </summary>

          <div class="venue-choice-content venue-choice-content--travel">
            <section class="venue-choice-section" aria-labelledby="venue-map-title">
              <h3 id="venue-map-title" class="venue-choice-heading">So findest du uns</h3>
              <div class="venue-map-panel">
                <p>{kardinal.kartenhinweis}</p>
                <div class="venue-map-actions">
                  <a class="button" href={kardinal.route} target="_blank" rel="noopener noreferrer">Route in Google Maps planen <span class="sr-only">(öffnet in neuem Tab)</span></a>
                  <a class="venue-text-link" href={kardinal.karte} target="_blank" rel="noopener noreferrer">Auf OpenStreetMap ansehen <span class="sr-only">(öffnet in neuem Tab)</span></a>
                </div>
              </div>
            </section>

            <section class="venue-choice-section" aria-labelledby="oepnv-title">
              <h3 class="venue-choice-heading" id="oepnv-title">Anfahrt mit dem öffentlichen Nahverkehr</h3>
              <div class="venue-transit-grid">
                {haltestellen.map((halt) => (
                  <article class="venue-transit-card">
                    <img src={bild(halt.bild)} alt={halt.alt} width={halt.breite || 976} height={halt.hoehe || 686} loading="lazy" decoding="async" />
                    <div class="venue-transit-text"><h4>{halt.name}</h4><p>{halt.beschreibung}</p></div>
                  </article>
                ))}
              </div>
              <p class="venue-transit-hint">{kardinal.oepnvHinweis}</p>
            </section>

            <section class="venue-choice-section" aria-labelledby="auto-title">
              <h3 id="auto-title" class="venue-choice-heading">Anfahrt mit dem Auto</h3>
              <div class="venue-split venue-split--photo-last">
                <div class="venue-copy">
                  <p>{kardinal.autoBeschreibung}</p>
                  <a class="button" href={kardinal.route} target="_blank" rel="noopener noreferrer">Anfahrt planen <span class="sr-only">(öffnet in neuem Tab)</span></a>
                </div>
                <img class="venue-lead-image" src={bild(kardinal.parkbild)} alt={kardinal.parkbildAlt} width="1600" height="900" loading="lazy" decoding="async" />
              </div>
            </section>
          </div>
        </details>

        <details class="venue-collapse venue-collapse--card">
          <summary class="venue-collapse-summary">
            <span class="venue-collapse-summary-text">
              <span class="venue-area-number">Wegbeschreibung</span>
              <strong>Vom Vorplatz bis zum Spieltisch</strong>
              <span>{wegschritte.length} nummerierte Fotos zeigen den Weg in den großen Saal</span>
            </span>
            <span class="venue-collapse-icon" aria-hidden="true"></span>
          </summary>
          <div class="venue-choice-content">
            <section aria-labelledby="weg-title">
              <h3 id="weg-title" class="venue-choice-heading">Vom Vorplatz bis zum Spieltisch – in {wegschritte.length} Schritten</h3>
              <div class="venue-route-grid">
                {wegschritte.map((schritt, i) => (
                  <figure class="venue-route-card">
                    <div class="venue-route-image">
                      <img src={bild(schritt.bild)} alt={schritt.alt} width={schritt.breite || 1200} height={schritt.hoehe || 800} loading="lazy" decoding="async" />
                    </div>
                    <figcaption>
                      <span class="venue-step-number" aria-label={`Schritt ${i + 1}`}>{String(i + 1).padStart(2, '0')}</span>
                      <span>{schritt.text}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          </div>
        </details>
      </div>
    </div>
  </section>

  <section id="rheinisches-landestheater" class="band band--white" aria-labelledby="theater-title">
    <div class="shell venue-split venue-theater">
      <div class="venue-copy">
        <p class="venue-kicker venue-kicker--place">Spielort 02</p>
        <h2 id="theater-title">{theater.name}</h2>
        <p>{theater.beschreibung}</p>
        <address>{theater.eingang}<br />{theater.plzOrt}</address>
        <p>{theater.anreiseBeschreibung}</p>
        <div class="venue-theater-actions">
          <a class="button" href={theater.route} target="_blank" rel="noopener noreferrer">Route zum Theater planen <span class="sr-only">(öffnet in neuem Tab)</span></a>
          <a class="venue-text-link" href={theater.website} target="_blank" rel="noopener noreferrer">Anreiseinfos des Theaters <span class="sr-only">(öffnet in neuem Tab)</span></a>
        </div>
      </div>
      <div class="venue-theater-visual" aria-hidden="true">
        <img src={bild(theater.logo)} alt="" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="band band--blue venue-theater-areas" aria-labelledby="theater-areas-title">
    <div class="shell">
      <h2 id="theater-areas-title" class="section-heading">Wo genau spielen wir im Theater?</h2>
      <p class="venue-area-intro">{theater.bereichHinweis}</p>
      <div class="venue-choices">
        <details class="venue-collapse venue-collapse--card">
          <summary class="venue-collapse-summary">
            <span class="venue-collapse-summary-text">
              <span class="venue-area-number">Spielort 02a</span>
              <strong>Offenes Foyer</strong>
              <span>{theaterFoyerSteps.length} Bilder zeigen den Weg zum Spielebereich.</span>
            </span>
            <span class="venue-collapse-icon" aria-hidden="true"></span>
          </summary>
          <div class="venue-choice-content">
            <p>{theater.foyerEinleitung}</p>
            <div class="venue-foyer-steps" aria-label={`${theaterFoyerSteps.length} Schritte zum offenen Foyer im Rheinischen Landestheater`}>
              {theaterFoyerSteps.map((schritt, index) => (
                <figure class="venue-foyer-step">
                  <div class="venue-foyer-step-image">
                    <img src={bild(schritt.bild)} alt={schritt.alt} width={schritt.breite || 960} height={schritt.hoehe || 640} loading="lazy" decoding="async" />
                  </div>
                  <figcaption>
                    <span class="venue-step-number">{String(index + 1).padStart(2, '0')}</span>
                    <span>{schritt.text}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </details>

        <details class="venue-collapse venue-collapse--card">
          <summary class="venue-collapse-summary">
            <span class="venue-collapse-summary-text">
              <span class="venue-area-number">Spielort 02b</span>
              <strong>Altes Herzstück</strong>
              <span>Direkt unten am Eingang, von außen einsehbar.</span>
            </span>
            <span class="venue-collapse-icon" aria-hidden="true"></span>
          </summary>
          <div class="venue-choice-content">
            <p>{theater.herzstueckBeschreibung}</p>
            <figure class="venue-heart-photo">
              <img src={bild(theater.herzstueckBild)} alt={theater.herzstueckBildAlt} width="650" height="480" loading="lazy" decoding="async" />
              <figcaption>{theater.herzstueckBildtext}</figcaption>
            </figure>
          </div>
        </details>
      </div>
    </div>
  </section>
</Layout>
