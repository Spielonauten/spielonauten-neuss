---
import Layout from '../layouts/Layout.astro';
import UeberUnsGalerie from '../components/UeberUnsGalerie.astro';
import { partner } from '../data/partner.js';
import seitentexte from '../content/seitentexte.json';
import { formatierterText } from '../utils/sichererText.js';
const texte = seitentexte.ueberUns;
const absaetze = Array.isArray(texte.abschnitte) ? texte.abschnitte : [];
const foerderverein = partner.find((eintrag) => eintrag.id === 'fkbh');
---
<Layout title="Über uns" description="Wer sind die Spielonauten Neuss? Erfahre mehr über unsere Brettspielgemeinschaft, unsere Geschichte und unser ehrenamtliches Engagement.">
  <section class="band band--blue title-hero about-title" aria-labelledby="about-heading">
    <div class="shell narrow">
      <h1 id="about-heading">{texte.titel}</h1>
    </div>
  </section>

  <section class="band band--white about-intro" aria-labelledby="about-heading">
    <div class="shell about-prose">
      {absaetze.map((absatz) => (
        <p set:html={formatierterText(absatz)}></p>
      ))}
      {foerderverein && (
        <div class="about-action">
          <a class="button" href={foerderverein.website} target="_blank" rel="noopener noreferrer">{texte.foerdervereinButton} <span class="sr-only">(öffnet in neuem Tab)</span></a>
        </div>
      )}
    </div>
  </section>

  <section class="band band--blue about-photos" aria-labelledby="about-photos-heading">
    <div class="shell">
      <h2 id="about-photos-heading" class="section-heading">{texte.galerieTitel}</h2>
      <p class="about-gallery-intro">{texte.galerieEinleitung}</p>
      <UeberUnsGalerie />
    </div>
  </section>
</Layout>
