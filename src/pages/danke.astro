---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Vielen Dank für deine Nachricht" description="Bestätigung einer Kontaktanfrage an die Spielonauten Neuss.">
  <section class="band band--blue thanks-section">
    <div class="shell narrow thanks-inner">
      <div class="thanks-symbol" aria-hidden="true">✓</div>
      <h1>Vielen Dank für deine Nachricht!</h1>
      <p>Deine Nachricht wurde übermittelt. Wir melden uns so bald wie möglich bei dir.</p>
      <p class="thanks-secondary">Wenn du uns noch etwas mitteilen möchtest, kannst du das Kontaktformular erneut verwenden.</p>
      <a class="button" href={`${base}/`}>Zurück zur Startseite</a>
    </div>
  </section>
</Layout>
