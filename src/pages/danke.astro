---
import Layout from '../layouts/Layout.astro';
import seitentexte from '../content/seitentexte.json';
const texte = seitentexte.danke;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Vielen Dank für deine Nachricht" description="Bestätigung einer Kontaktanfrage an die Spielonauten Neuss.">
  <section class="band band--blue thanks-section">
    <div class="shell narrow thanks-inner">
      <div class="thanks-symbol" aria-hidden="true">✓</div>
      <h1>{texte.titel}</h1>
      <p>{texte.text}</p>
      <p class="thanks-secondary">{texte.hinweis}</p>
      <a class="button" href={`${base}/`}>{texte.button}</a>
    </div>
  </section>
</Layout>
