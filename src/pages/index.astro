---
import Layout from '../layouts/Layout.astro';
import VeranstaltungsSlider from '../components/VeranstaltungsSlider.astro';
import Kontaktformular from '../components/Kontaktformular.astro';
import { partner } from '../data/partner.js';
import seitentexte from '../content/seitentexte.json';
import { formatierterText } from '../utils/sichererText.js';
const texte = seitentexte.startseite;
const infokarten = Array.isArray(texte.infokarten) ? texte.infokarten : [];
const spielorteAbsaetze = Array.isArray(texte.spielorteText) ? texte.spielorteText : [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImage = `${base}/bilder/startseite/meeples-startseite.jpg`;
const saalFoto = `${base}/bilder/spielorte/spielsaal.webp`;
---
<Layout title="Gemeinsam Brettspiele spielen in Neuss" description="Spielonauten Neuss: Entdecke offene Brettspieleabende, Rheingespielt, XXL-Spieletage und weitere Veranstaltungen. Gemeinsam spielen – kostenlos und offen für alle.">
  <section class="band band--blue hero">
    <div class="shell hero-grid">
      <img class="hero-photo" src={heroImage} alt="Rote, blaue und gelbe Spielfiguren auf einem Brettspiel" width="822" height="464" />
      <div class="hero-copy">
        <h1>{texte.heroTitel}</h1>
        <p set:html={formatierterText(texte.heroText)}></p>
      </div>
    </div>
  </section>
  <VeranstaltungsSlider />
  <section class="band band--blue" aria-labelledby="ablauf">
    <div class="shell">
      <h2 class="section-heading" id="ablauf">{texte.ablaufTitel}</h2>
      <div class="info-grid">
        {infokarten.map((karte) => (
          <article class="info-card">
            <h3>{karte.titel}</h3>
            <p set:html={formatierterText(karte.text)}></p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="band band--white" aria-labelledby="partner">
    <div class="shell">
      <h2 class="section-heading" id="partner">{texte.partnerTitel}</h2>
      <div class="partner-grid">
        {partner.map((item) => (
          <article class="partner-card">
            <div class="partner-logo-space">
              <img
                src={`${base}/${item.logo}`}
                alt={`Logo von ${item.name}`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3>{item.name}</h3>
            <p>{item.beschreibung}</p>
            <a class="button partner-button" href={item.website} target="_blank" rel="noopener noreferrer">
              Mehr erfahren <span class="sr-only">über {item.name} (öffnet in neuem Tab)</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Kontaktformular />
  <section class="band band--white">
    <div class="shell hero-grid">
      <img class="venue-home-image" src={saalFoto} alt="Großer Spielsaal im Kardinal-Bea-Haus mit Tischen und Stühlen für die Spieleabende" width="1089" height="816" loading="lazy" decoding="async" />
      <div class="venue-home-copy">
        <h2>{texte.spielorteTitel}</h2>
        {spielorteAbsaetze.map((absatz) => (
          <p set:html={formatierterText(absatz)}></p>
        ))}
        <a class="button" href={`${base}/wo-wird-gespielt/`}>{texte.spielorteButton}</a>
      </div>
    </div>
  </section>
  <section class="band band--blue section-center">
    <div class="shell narrow">
      <h2>{texte.instagramTitel}</h2>
      <p set:html={formatierterText(texte.instagramText)}></p>
      <a class="button" href="https://www.instagram.com/spielonauten_neuss/" target="_blank" rel="noopener noreferrer">{texte.instagramButton} <span class="sr-only">(öffnet in neuem Tab)</span></a>
    </div>
  </section>
</Layout>
