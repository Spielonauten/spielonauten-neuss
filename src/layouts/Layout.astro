---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Spielonauten Neuss – gemeinsam Brettspiele erleben.' } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Erst bei offizieller Ablösung der Jimdo-Seite entfernen. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2f83a8" />
    <title>{title} | Spielonauten Neuss</title>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
