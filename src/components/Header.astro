---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'Startseite', path: '/' },
  { label: 'Veranstaltungen', path: '/veranstaltungen/' },
  { label: 'Wo wird gespielt?', path: '/wo-wird-gespielt/' },
  { label: 'Über uns', path: '/ueber-uns/' },
];
const linkFor = (path) => `${base}${path}`;
const active = (path) => (path === '/' ? currentPath === base : currentPath === `${base}${path}`.replace(/\/$/, ''));
const logo = `${base}/bilder/logo/spielonauten-logo.png`;
---
<header class="site-header">
  <div class="shell header-content">
    <a class="brand" href={linkFor('/')} aria-label="Spielonauten Neuss – Startseite">
      <img class="brand-logo" src={logo} alt="Logo der Spielonauten Neuss" width="44" height="44" />
      <span>Spielonauten-Neuss</span>
    </a>

    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {nav.map((item) => (
        <a href={linkFor(item.path)} aria-current={active(item.path) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Hauptmenü öffnen oder schließen">
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="sr-only">Menü</span>
      </summary>
      <nav aria-label="Mobile Hauptnavigation">
        {nav.map((item) => (
          <a href={linkFor(item.path)} aria-current={active(item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
