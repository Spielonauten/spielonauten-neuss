---
import { veranstaltungen } from '../data/veranstaltungen.js';
import seitentexte from '../content/seitentexte.json';
import { naechsterBestaetigterTermin } from '../data/terminanzeige.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const startBild = `${base}/bilder/startseite/meeples-startseite.jpg`;
const bildUrl = (event) => event.bild ? `${base}/${event.bild.replace(/^\//, '')}` : startBild;

// Der nächste bestätigte Einzeltermin entscheidet über die Reihenfolge.
// Formate ohne bestätigten Zukunftstermin bleiben sichtbar, aber am Ende.
const terminSchluessel = (termine) => {
  const termin = naechsterBestaetigterTermin(termine);
  return termin ? `${termin.datum}T${termin.beginn || '00:00'}` : '9999-12-31T23:59';
};
const sortierteVeranstaltungen = [...veranstaltungen].sort((a, b) =>
  terminSchluessel(a.termine).localeCompare(terminSchluessel(b.termine))
);
---
<section class="events-section" aria-labelledby="termine">
  <div class="events-heading shell">
    <h2 id="termine">{seitentexte.veranstaltungen.sliderTitel}</h2>
  </div>
  <div class="events-carousel" data-event-carousel role="region" aria-roledescription="Karussell" aria-label="Unsere Veranstaltungen" style={`--events-photo: url("${bildUrl(sortierteVeranstaltungen[0])}");`}>
    <button class="events-arrow events-arrow--prev" type="button" data-carousel-prev aria-label="Vorherige Veranstaltung">
      <span aria-hidden="true">&#8249;</span>
    </button>
    <div class="events-stage">
      {sortierteVeranstaltungen.map((event, i) => (
        <article
          class="event-slide"
          data-event-slide
          data-termine={JSON.stringify(event.termine)}
          data-event-background={bildUrl(event)}
          hidden={i !== 0}
          aria-label={`${i + 1} von ${sortierteVeranstaltungen.length}: ${event.titel}`}
        >
          <div class="event-panel">
            <h3>{event.titel}</h3>
            <p class="event-subtitle">{event.untertitel}</p>
            <p>{event.beschreibung}</p>
            <p class="event-detail"><strong>Nächster Termin:</strong> <span data-next-term>{event.termin}</span></p>
            <p class="event-detail event-status-notice" data-termin-hinweis hidden={!event.terminHinweis}>{event.terminHinweis}</p>
            <p class="event-detail"><strong>Wo:</strong> {event.ort}</p>
            <a class="button" href={`${base}/veranstaltungen/#${event.id}`}>Alle Informationen</a>
          </div>
        </article>
      ))}
    </div>
    <button class="events-arrow events-arrow--next" type="button" data-carousel-next aria-label="Nächste Veranstaltung">
      <span aria-hidden="true">&#8250;</span>
    </button>
    <div class="events-dots" role="group" aria-label="Veranstaltung auswählen">
      {sortierteVeranstaltungen.map((event, i) => (
        <button
          type="button"
          data-carousel-dot
          data-index={i}
          aria-label={`Veranstaltung: ${event.titel}`}
          aria-current={i === 0 ? 'true' : undefined}
        ></button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-status></p>
  </div>
</section>

<script>
  import { naechsterTerminText, dringenderTerminHinweis, naechsterBestaetigterTermin } from '../data/terminanzeige.js';
  for (const carousel of document.querySelectorAll('[data-event-carousel]')) {
    const urspruenglicheSlides = [...carousel.querySelectorAll('[data-event-slide]')];
    const urspruenglicheDots = [...carousel.querySelectorAll('[data-carousel-dot]')];
    const prev = carousel.querySelector('[data-carousel-prev]');
    const next = carousel.querySelector('[data-carousel-next]');
    const status = carousel.querySelector('[data-carousel-status]');
    const stage = carousel.querySelector('.events-stage');
    const dotsContainer = carousel.querySelector('.events-dots');

    // Auch ohne neuen GitHub-Build die Reihenfolge beim Seitenaufruf neu
    // bestimmen: Nach Ablauf des 9. November wird automatisch der 19. November
    // nach vorne gestellt, sofern kein früherer bestätigter Termin existiert.
    const eintraege = urspruenglicheSlides.map((slide, index) => {
      const termine = JSON.parse(slide.dataset.termine || '[]');
      const termin = naechsterBestaetigterTermin(termine);
      const schluessel = termin ? `${termin.datum}T${termin.beginn || '00:00'}` : '9999-12-31T23:59';
      return { slide, dot: urspruenglicheDots[index], termine, schluessel, index };
    }).sort((a, b) => a.schluessel.localeCompare(b.schluessel) || a.index - b.index);

    eintraege.forEach(({ slide, dot, termine }, index) => {
      stage.append(slide);
      dotsContainer.append(dot);
      slide.setAttribute('aria-label', `${index + 1} von ${eintraege.length}: ${slide.querySelector('h3')?.textContent || ''}`);
      dot.dataset.index = String(index);

      const anzeige = slide.querySelector('[data-next-term]');
      if (anzeige) anzeige.textContent = naechsterTerminText(termine);
      const hinweis = slide.querySelector('[data-termin-hinweis]');
      if (hinweis) {
        const text = dringenderTerminHinweis(termine);
        hinweis.textContent = text;
        hinweis.hidden = !text;
      }
    });

    const slides = eintraege.map(({ slide }) => slide);
    const dots = eintraege.map(({ dot }) => dot);
    const available = slides.map((_, index) => index);
    let position = 0;

    const show = (newPosition, announce = false) => {
      position = (newPosition + available.length) % available.length;
      const selected = available[position];
      const selectedImage = slides[selected]?.dataset.eventBackground;
      if (selectedImage) carousel.style.setProperty('--events-photo', `url("${selectedImage}")`);
      slides.forEach((slide, i) => { slide.hidden = i !== selected; });
      dots.forEach((dot, i) => {
        dot.hidden = !available.includes(i);
        if (i === selected) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
      prev.disabled = available.length < 2;
      next.disabled = available.length < 2;
      if (announce && status) {
        status.textContent = slides[selected].querySelector('h3')?.textContent || '';
      }
    };

    prev.addEventListener('click', () => show(position - 1, true));
    next.addEventListener('click', () => show(position + 1, true));
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const newPosition = available.indexOf(i);
        if (newPosition >= 0) show(newPosition, true);
      });
    });
    carousel.addEventListener('keydown', (event) => {
      if (event.target instanceof HTMLElement && ['INPUT', 'TEXTAREA'].includes(event.target.tagName)) return;
      if (event.key === 'ArrowRight') { event.preventDefault(); show(position + 1, true); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(position - 1, true); }
    });
    show(0);
  }
</script>
