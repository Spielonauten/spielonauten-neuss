---
interface Veranstaltung {
  id: string;
  titel: string;
  untertitel: string;
  beschreibung: string;
  termin: string;
  datum: string;
  art: string;
  typ: string;
  rhythmus: string;
  termine: Array<{ format: string; datum: string; beginn: string; ende?: string; status: string; hinweis?: string }>;
  kommendeTermine: Array<{ format: string; datum: string; beginn: string; ende?: string; status: string; hinweis?: string }>;
  ort: string;
  teilnahme: string;
  hinweise: string[];
  bild?: string;
  bildBreite?: number;
  bildHoehe?: number;
}
interface Props {
  veranstaltung: Veranstaltung;
  position: number;
}
const { veranstaltung: event, position } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logo = `${base}/bilder/logo/spielonauten-logo.png`;
const hasPoster = Boolean(event.bild);
const posterUrl = hasPoster ? `${base}/${event.bild?.replace(/^\//, '')}` : '';
import { statusText } from '../data/terminanzeige.js';
const artLabel = event.typ === 'regelmaessig' ? 'Regelmäßige Veranstaltung' : event.typ === 'grossveranstaltung' ? 'Großveranstaltung' : 'Unregelmäßige Veranstaltung';
---
<section
  class:list={['band', position % 2 === 0 ? 'band--white' : 'band--blue', 'event-feature']}
  id={event.id}
  data-event-feature
  data-event-terms={JSON.stringify(event.termine)}
  aria-labelledby={`title-${event.id}`}
>
  <div class="shell event-feature-grid">
    <div class="event-feature-copy">
      <p class="event-type">{artLabel}</p>
      <h2 id={`title-${event.id}`}>{event.titel}</h2>
      <p class="event-feature-subtitle">{event.untertitel}</p>
      <p>{event.beschreibung}</p>
      <p class="event-rhythm"><strong>Üblicher Rhythmus:</strong> {event.rhythmus}</p>
      <dl class="event-facts">
        <div>
          <dt>Nächster bestätigter Termin</dt>
          <dd data-event-next>{event.termin}</dd>
        </div>
        <div>
          <dt>Wo</dt>
          <dd>{event.ort}</dd>
        </div>
        <div>
          <dt>Teilnahme</dt>
          <dd>{event.teilnahme}</dd>
        </div>
      </dl>
      {event.hinweise.map((hinweis) => <p class="event-extra">{hinweis}</p>)}
      <div class="event-upcoming" data-event-upcoming>
        <h3>Alle kommenden Termine</h3>
        <ul data-event-upcoming-list>
          {event.kommendeTermine.length ? event.kommendeTermine.map((termin) => (
            <li class:list={['event-term-item', `event-term-item--${termin.status}`]}>{statusText(termin)}</li>
          )) : <li>Weitere Termine werden noch bekannt gegeben.</li>}
        </ul>
      </div>
      <a class="button" href={`${base}/wo-wird-gespielt/`}>Informationen zu unseren Spielorten</a>
    </div>
    <div class="event-feature-media">
      {hasPoster ? (
        <img class="event-poster" src={posterUrl} alt={`Veranstaltungsflyer: ${event.titel}`} width={event.bildBreite} height={event.bildHoehe} loading="lazy" decoding="async" />
      ) : (
        <div class="event-poster-fallback">
          <img src={logo} alt="" width="104" height="104" loading="lazy" />
          <span class="event-poster-kicker">Spielonauten Neuss</span>
          <strong>{event.titel}</strong>
          <span class="event-poster-subtitle">{event.untertitel}</span>
          <span class="event-poster-note">Originalflyer folgt</span>
        </div>
      )}
    </div>
  </div>
</section>
