---
import { statusText } from '../data/terminanzeige.js';

// Die Daten stammen aus den JSON-Dateien, die in Pages CMS gepflegt werden.
// Bewusst einfache JavaScript-Ausdruecke, damit die Komponente stabil gebaut wird.
const { veranstaltung: event, position } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logo = `${base}/bilder/logo/spielonauten-logo.png`;
const hasPoster = Boolean(event.bild);
const posterUrl = hasPoster ? `${base}/${String(event.bild).replace(/^\//, '')}` : '';
const bandClass = Number(position) % 2 === 0 ? 'band--white' : 'band--blue';
const formatLabel = event.typ === 'regelmaessig'
  ? 'Regelmäßige Veranstaltung'
  : event.typ === 'grossveranstaltung'
    ? 'Großveranstaltung'
    : 'Unregelmäßige Veranstaltung';
const einzeltermine = Array.isArray(event.termine) ? event.termine : [];
const kommendeTermine = Array.isArray(event.kommendeTermine) ? event.kommendeTermine : [];
const hinweise = Array.isArray(event.hinweise) ? event.hinweise : [];
// Optionaler Link direkt zu Anmeldung/Veranstaltungsinfos. Kein Link? Bisheriger Spielorte-Button.
// Akzeptiert nur HTTPS-Adressen, damit fehlerhafte CMS-Eingaben keinen unsicheren Link erzeugen.
const eingegebenerButtonLink = typeof event.buttonUrl === 'string' ? event.buttonUrl.trim() : '';
let eigenerButtonLink = '';
try {
  const adresse = new URL(eingegebenerButtonLink);
  if (adresse.protocol === 'https:' && adresse.hostname.includes('.')) {
    eigenerButtonLink = adresse.href;
  }
} catch {
  // Leer oder ungültig: der ursprüngliche Spielorte-Link bleibt erhalten.
}
const buttonLink = eigenerButtonLink || `${base}/wo-wird-gespielt/`;
const buttonText = eigenerButtonLink
  ? (String(event.buttonText || '').trim() || 'Weitere Informationen / Anmeldung')
  : 'Informationen zu unseren Spielorten';

---
<section
  class={`band ${bandClass} event-feature`}
  id={event.id}
  data-event-feature
  data-event-terms={JSON.stringify(einzeltermine)}
  aria-labelledby={`title-${event.id}`}
>
  <div class="shell event-feature-grid">
    <div class="event-feature-copy">
      <p class="event-type">{formatLabel}</p>
      <h2 id={`title-${event.id}`}>{event.titel}</h2>
      <p class="event-feature-subtitle">{event.untertitel}</p>
      <p>{event.beschreibung}</p>
      <p class="event-rhythm"><strong>Üblicher Rhythmus:</strong> {event.rhythmus}</p>

      <dl class="event-facts">
        <div>
          <dt>Nächster bestätigter Termin</dt>
          <dd data-event-next>{event.termin}</dd>
        </div>
        <div>
          <dt>Wo</dt>
          <dd>{event.ort}</dd>
        </div>
        <div>
          <dt>Teilnahme</dt>
          <dd>{event.teilnahme}</dd>
        </div>
      </dl>

      {hinweise.map((hinweis) => (
        <p class="event-extra">{hinweis}</p>
      ))}

      <div class="event-upcoming" data-event-upcoming>
        <h3>Alle kommenden Termine</h3>
        <ul data-event-upcoming-list>
          {kommendeTermine.map((termin) => (
            <li class={`event-term-item event-term-item--${termin.status}`}>{statusText(termin)}</li>
          ))}
          {kommendeTermine.length === 0 && (
            <li>Weitere Termine werden noch bekannt gegeben.</li>
          )}
        </ul>
      </div>

      <a
        class="button"
        href={buttonLink}
        target={eigenerButtonLink ? '_blank' : undefined}
        rel={eigenerButtonLink ? 'noopener noreferrer' : undefined}
      >
        {buttonText}
        {eigenerButtonLink && <span class="sr-only"> (öffnet in neuem Tab)</span>}
      </a>
    </div>

    <div class="event-feature-media">
      {hasPoster && (
        <img
          class="event-poster"
          src={posterUrl}
          alt={`Veranstaltungsflyer: ${event.titel}`}
          width={event.bildBreite}
          height={event.bildHoehe}
          loading="lazy"
          decoding="async"
        />
      )}
      {!hasPoster && (
        <div class="event-poster-fallback">
          <img src={logo} alt="" width="104" height="104" loading="lazy" />
          <span class="event-poster-kicker">Spielonauten Neuss</span>
          <strong>{event.titel}</strong>
          <span class="event-poster-subtitle">{event.untertitel}</span>
          <span class="event-poster-note">Originalflyer folgt</span>
        </div>
      )}
    </div>
  </div>
</section>
